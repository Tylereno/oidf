{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oidf.dev/schemas/architecture_sat_gate_map.json",
  "title": "OIDFArchitectureSatGateMap",
  "description": "Machine-readable mapping from architecture-pack safety gates to SAT gate_id values and expected Evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "spec_version", "gate_namespace", "gates"],
  "properties": {
    "$schema": { "type": "string" },
    "pack_id": { "type": "string", "minLength": 1 },
    "spec_version": { "type": "string", "const": "1.0.0" },
    "gate_namespace": { "type": "string", "minLength": 1 },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "safety_gate",
          "sat_protocol_step",
          "required_result",
          "evidence_types",
          "ledger_transition"
        ],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "safety_gate": { "type": "string", "minLength": 1 },
          "sat_protocol_step": { "type": "integer", "minimum": 1 },
          "required_result": { "type": "string", "enum": ["pass", "fail", "blocked"] },
          "evidence_catalogs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "evidence_types": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "ledger_transition": { "type": "string", "minLength": 1 },
          "example_required": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
