{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tylereno.me/oidf/schemas/event/payloads/evidence_submitted.json",
  "title": "EvidenceSubmittedPayload",
  "x-keel-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "evidence_type", "subject_kind", "subject_id"],
  "properties": {
    "evidence_id": { "$ref": "../../common/identifier.json" },
    "evidence_type": { "type": "string", "minLength": 1 },
    "subject_kind": { "type": "string", "enum": ["Deployment", "Asset"] },
    "subject_id": { "$ref": "../../common/identifier.json" },
    "artifact_uri": { "type": "string", "minLength": 1 },
    "valid_from": { "$ref": "../../common/timestamp.json" },
    "valid_until": { "$ref": "../../common/timestamp.json" },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
