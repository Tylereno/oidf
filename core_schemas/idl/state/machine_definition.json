{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlexicon.github.io/oidf/schemas/state/machine_definition.json",
  "title": "MachineDefinition",
  "description": "Deterministic finite state machine definition (RFC 0005).",
  "x-keel-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "subject_kind", "initial_state", "states", "transitions"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "subject_kind": { "type": "string", "enum": ["Deployment", "Asset"] },
    "initial_state": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "terminal_states": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "evidence_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_type"],
              "properties": {
                "evidence_type": { "type": "string", "minLength": 1 },
                "min_count": { "type": "integer", "minimum": 1, "default": 1 }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "EvidenceSufficient",
                    "AssetStateIn",
                    "DeploymentStateIn",
                    "CdoRevisionPinned"
                  ]
                },
                "asset_id": { "$ref": "../common/identifier.json" },
                "deployment_id": { "$ref": "../common/identifier.json" },
                "allowed_states": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "cdo_revision": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "required_permission": {
            "type": "string",
            "default": "transition.request"
          }
        }
      }
    }
  }
}
