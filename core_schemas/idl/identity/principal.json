{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlexicon.github.io/oidf/schemas/identity/principal.json",
  "title": "Principal",
  "x-keel-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind"],
  "properties": {
    "id": { "$ref": "../common/identifier.json" },
    "kind": {
      "type": "string",
      "enum": ["human", "service", "plugin", "node"]
    },
    "display_name": { "type": "string" },
    "roles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
